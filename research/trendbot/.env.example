# Copy to .env in the directory you start the bot from (or point TRENDBOT_ENV_FILE at it).
# Easiest: leave this file alone and add keys in the dashboard (Connections card); it writes
# them here for you. Never commit .env. Use keys with TRADE permission only (no withdrawals),
# IP-restricted if the exchange allows it. Paper mode needs no keys at all.

# One key set per exchange and account (used first):
# TRENDBOT_BINANCE_TESTNET_API_KEY=
# TRENDBOT_BINANCE_TESTNET_API_SECRET=
# TRENDBOT_BINANCE_API_KEY=
# TRENDBOT_BINANCE_API_SECRET=
# TRENDBOT_COINBASE_API_KEY=
# TRENDBOT_COINBASE_API_SECRET=

# Fallback for any exchange/account without its own keys:
TRENDBOT_API_KEY=
TRENDBOT_API_SECRET=
# Only for exchanges that require a passphrase:
# TRENDBOT_API_PASSWORD=

# Optional data sources:
# CRYPTOPANIC_TOKEN=
# SOLANA_RPC_URL=
# MCP server tokens are written here by the dashboard as TRENDBOT_MCP_<NAME>_TOKEN=
