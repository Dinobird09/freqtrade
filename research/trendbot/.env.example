# Copy to .env in the directory you start the bot from (or point TRENDBOT_ENV_FILE at it).
# Never commit .env. Use keys with TRADE permission only (no withdrawals), IP-restricted if
# the exchange allows it. Paper mode needs no keys at all.
TRENDBOT_API_KEY=
TRENDBOT_API_SECRET=
# Only for exchanges that require a passphrase:
# TRENDBOT_API_PASSWORD=
